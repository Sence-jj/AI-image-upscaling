generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  
  quota         UserQuota?
  records       UpscaleRecord[]
  invitations   Invitation[]     @relation("Inviter")
  invitedBy     Invitation?      @relation("Invitee")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserQuota {
  userId       String @id
  freeQuota    Int    @default(1)
  paidQuota    Int    @default(0)
  inviteEarned Int    @default(0)
  inviteCount  Int    @default(0)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String    @id @default(cuid())
  inviterId   String
  inviteeId   String?   @unique
  inviteCode  String    @unique
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  
  inviter User  @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
}

model UpscaleRecord {
  id               String    @id @default(cuid())
  userId           String
  originalFilename String
  originalSize     Int
  scaleFactor      Int
  status           String    @default("processing")
  resultUrl        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
}
